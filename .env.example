# Copy to .env for local use. Never commit .env.
# The defaults below are for the local Docker database only.

# --- Database (owner login: migrations, data load, controls) -------------
POSTGRES_DB=finance
POSTGRES_USER=finance_owner
POSTGRES_PASSWORD=change-me-local-only
# Inside Docker Compose the host is "db"; from your own machine it is localhost
# on DB_HOST_PORT. Change the ports below if they are taken on your machine.
DB_HOST_PORT=15432
APP_HOST_PORT=8000
DATABASE_URL=postgresql://finance_owner:change-me-local-only@localhost:15432/finance

# --- Web app (read-only login) --------------------------------------------
REPORTING_DB_USER=reporting_app
REPORTING_DB_PASSWORD=change-me-too
REPORTING_DATABASE_URL=postgresql://reporting_app:change-me-too@localhost:15432/finance

# --- Sign-in ----------------------------------------------------------------
# demo   : demo users, labelled as such (portfolio / local use)
# google : Google Workspace sign-in, one domain only
AUTH_MODE=demo
# At least 32 random characters. Required for AUTH_MODE=google.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true when served over HTTPS (always, outside your own machine)
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=

# --- Presentation -----------------------------------------------------------
COMPANY_NAME=Halden Supply Co.
REPORT_CURRENCY=EUR
